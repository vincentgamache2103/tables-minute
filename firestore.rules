rules_version = '2';

// Tables minute : version classe (Firestore, Montréal).
// Le serveur ne reçoit que du texte chiffré dans le navigateur (voir classe.js).
service cloud.firestore {
  match /databases/{database}/documents {

    // Une classe : un seul document chiffré, créé une fois et jamais modifié.
    match /classes/{classId} {
      allow get: if true;
      allow create: if classId.matches('^[A-Za-z0-9_-]{16}$')
        && request.resource.data.keys().hasOnly(['d', 'v'])
        && request.resource.data.d is string
        && request.resource.data.d.size() > 40
        && request.resource.data.d.size() <= 8000
        && request.resource.data.v == 1;

      // Les résultats : chiffrés pour le prof seul. On peut seulement en ajouter.
      match /r/{resultId} {
        allow get: if true;
        allow list: if request.query.limit <= 300;
        allow create: if resultId.matches('^[A-Za-z0-9_-]{20}$')
          && request.resource.data.keys().hasOnly(['d', 't'])
          && request.resource.data.d is string
          && request.resource.data.d.size() > 120
          && request.resource.data.d.size() <= 4000
          && request.resource.data.t == request.time
          && exists(/databases/$(database)/documents/classes/$(classId));
      }

      // La feuille choisie par le prof : chiffrée avec la clé de la classe et signée par le prof
      // (les navigateurs vérifient la signature). Chaque changement ajoute un document; rien ne se modifie.
      match /s/{sheetId} {
        allow get: if true;
        allow list: if request.query.limit <= 50;
        allow create: if sheetId.matches('^[A-Za-z0-9_-]{20}$')
          && request.resource.data.keys().hasOnly(['d', 't'])
          && request.resource.data.d is string
          && request.resource.data.d.size() > 100
          && request.resource.data.d.size() <= 16000
          && request.resource.data.t == request.time
          && exists(/databases/$(database)/documents/classes/$(classId));
      }
    }
  }
}
